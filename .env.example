# Copy this file to .env.local (git-ignored) and adjust.

# DbTwig endpoint of the AsterionDB instance Hey Nav talks to.
# Through the SSH tunnel to the compute node (see README "Working against cloud-test"):
#   DB_TWIG_URL=http://localhost:8080/dbTwig
DB_TWIG_URL=https://cloud-test.asteriondb.com/dbTwig

# NOTE: PORT cannot be set here — Next.js binds its port before reading env files.
# Use `PORT=8080 npm start` or `npm start -- -p 8080`.

# Anonymous call made before login to fetch the service title / login-page settings.
# On cloud-test this is exposed by the dgBunker service. Point it at the Hey Nav
# DbTwig service once that is enrolled, e.g. heyNav/getLoginPageSettings
DB_TWIG_LOGIN_SETTINGS_API=dgBunker/getLoginPageSettings

# 1 = print full session ids in the server console instead of a redacted prefix.
DB_TWIG_LOG_SECRETS=0

# Opportunities query screen.
# 1 = evaluate queries in-memory over clearly-marked sample rows (UI testing before the
#     heyNav DbTwig service is enrolled). 0 = call DbTwig.
HEYNAV_SAMPLE_DATA=0
# Query mode when not in sample mode:
#   basic — call HEYNAV_LIST_API (no parameters) and filter/sort/page in the app. Use this
#           while heyNav/getBidOpportunities is the only entry point.
#   full  — POST the query to HEYNAV_QUERY_API and let the database do the work.
HEYNAV_QUERY_MODE=basic
HEYNAV_LIST_API=heyNav/getBidOpportunities
# DbTwig APIs for the screen (see db/heynav/).
HEYNAV_QUERY_API=heyNav/queryBidOpportunities
HEYNAV_GET_OPPORTUNITY_API=heyNav/getBidOpportunity
HEYNAV_SET_FLAGS_API=heyNav/setOpportunityFlags
HEYNAV_ATTACH_DOCUMENT_API=heyNav/attachDocument
HEYNAV_GET_DOCUMENTS_API=heyNav/getDocuments
HEYNAV_ASK_API=heyNav/askQuestion

# File upload (Vault). Multipart POST proxied by /api/upload with the session bearer.
HEYNAV_UPLOAD_API=dgBunker/uploadFiles
